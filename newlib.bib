  year =         1998,
  volume =       1,
  pages =        {893--908},
  annote =       {ICondensation is an extension of the original Condensation
                  algorithm {\textbackslash}citeisard:98:a. The paper proposes a
                  combination of Condensation with
                  {\textbackslash}emphimportance sampling for increasing the
                  efficiency of probabilistic tracking. In contrast to standard
                  sequential Monte Carlo methods, importance sampling chooses
                  the samples in the resampling step not with respect to their
                  likelihoods but to a so-called importance function. The
                  application in the paper is hand tracking thus skin color is
                  the natural choice as this "guiding" cue for importance
                  sampling. This well-written paper provides an almost natural
                  extension to the original probabilistic tracking algorithm
                  introduced by the same authorship.},
  keywords =     {Condensation, Importance Sampling, Particle Filter, Skin
                  Color, Tracking},
}

