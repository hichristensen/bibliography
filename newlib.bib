  institution =  {AT\&T Laboratories Cambridge},
  year =         2000,
  number =       {2000.14},
  annote =       {The authors approach the problem of CBIR by semantically
                  labeling image regions by high level visual categories. Visual
                  categories are e.g. brick, cloud, fur, grass, ice etc. The
                  image labeling is achieved by a set of neural network
                  classifiers. The classification rate per category is between
                  86\% and 87\%. The images are segmented into regions and the
                  resulting regions are labeled. The retrieval is started either
                  by using a sample image or by using a visual thesaurus.},
}

