@Article{eppstein_sparse_1992,
  author =       {Eppstein, D. and Galil, Z. and Giancarlo, R. and Italiano, G.
                  F.},
  title =        {Sparse dynamic programming {I}: linear cost functions},
  journal =      {J. ACM},
  year =         1992,
  volume =       39,
  number =       3,
  pages =        {519--545},
  note =         {Place: New York, NY, USA Publisher: ACM Press},
  issn =         {0004-5411},
  doi =          {http://doi.acm.org/10.1145/146637.146650},
  abstract =     {Dynamic programming solutions to a number of different
                  recurrence equations for sequence comparison and for RNA
                  secondary structure prediction are considered. These
                  recurrences are defined over a number of points that is
                  quadratic in the input size; however only a sparse set matters
                  for the result. Efficient algorithms for these problems are
                  given, when the weight functions used in the recurrences are
                  taken to be linear. The time complexity of the algorithms
                  depends almost linearly on the number of points that need to
                  be considered; when the problems are sparse this results in a
                  substantial speed-up over known algorithms.},
}

@Article{eppstein_sparse_1992-1,
  author =       {Eppstein, D. and Galil, Z. and Giancarlo, R. and Italiano, G.
                  F.},
  title =        {Sparse dynamic programming {II}: convex and concave cost
                  functions},
  journal =      {J. ACM},
  year =         1992,
  volume =       39,
  number =       3,
  pages =        {546--567},
  note =         {Place: New York, NY, USA Publisher: ACM Press},
  issn =         {0004-5411},
  doi =          {http://doi.acm.org/10.1145/146637.146656},
  abstract =     {Dynamic programming solutions to two recurrence equations,
                  used to compute a sequence alignment from a set of matching
                  fragments between two strings, and to predict RNA secondary
                  structure, are considered. These recurrences are defined over
                  a number of points that is quadratic in the input size;
                  however, only a sparse set matters for the result. Efficient
                  algorithms are given for solving these problems, when the cost
                  of a gap in the alignment or a loop in the secondary structure
                  is taken as a convex or concave function of the gap or loop
                  length. The time complexity of our algorithms depends almost
                  linearly on the number of points that need to be considered;
                  when the problems are sparse, this results in a substantial
                  speed-up over known algorithms.},
}

