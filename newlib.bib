@Misc{philionTrajeglishTrafficModeling2024,
  author =       {Philion, Jonah and Peng, Xue Bin and Fidler, Sanja},
  title =        {Trajeglish: {Traffic} {Modeling} as {Next}-{Token}
                  {Prediction}},
  month =        apr,
  year =         2024,
  note =         {arXiv:2312.04535 [cs]},
  annote =       {Comment: ICLR 2024},
  shorttitle =   {Trajeglish},
  url =          {http://arxiv.org/abs/2312.04535},
  abstract =     {A longstanding challenge for self-driving development is
                  simulating dynamic driving scenarios seeded from recorded
                  driving logs. In pursuit of this functionality, we apply tools
                  from discrete sequence modeling to model how vehicles,
                  pedestrians and cyclists interact in driving scenarios. Using
                  a simple data-driven tokenization scheme, we discretize
                  trajectories to centimeter-level resolution using a small
                  vocabulary. We then model the multi-agent sequence of discrete
                  motion tokens with a GPT-like encoder-decoder that is
                  autoregressive in time and takes into account intra-timestep
                  interaction between agents. Scenarios sampled from our model
                  exhibit state-of-the-art realism; our model tops the Waymo Sim
                  Agents Benchmark, surpassing prior work along the realism meta
                  metric by 3.3\% and along the interaction metric by 9.9\%. We
                  ablate our modeling choices in full autonomy and partial
                  autonomy settings, and show that the representations learned
                  by our model can quickly be adapted to improve performance on
                  nuScenes. We additionally evaluate the scalability of our
                  model with respect to parameter count and dataset size, and
                  use density estimates from our model to quantify the saliency
                  of context length and intra-timestep interaction for the
                  traffic modeling task.},
  language =     {en},
  urldate =      {2024-06-04},
  publisher =    {arXiv},
  keywords =     {Computer Science - Robotics, Computer Science - Machine
                  Learning},
  file =         {Philion et al. - 2024 - Trajeglish Traffic Modeling as
                  Next-Token
                  Predict.pdf:/Users/hic/Zotero/storage/VXAHBNPV/Philion et al.
                  - 2024 - Trajeglish Traffic Modeling as Next-Token
                  Predict.pdf:application/pdf},
}

