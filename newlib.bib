@Unpublished{mojsilovic_semantic_2002,
  author =       {Mojsilovic, A. and Rogowitz, Bernice E.},
  title =        {Semantic {Metric} for {Image} {Library} {Exploration}},
  note =         {Publication Title: IEEE Multimedia},
  year =         2002,
  annote =       {Summarizing
                  {\textbackslash}citemojsilovic02{\textbackslash}citemojsilovic02a{\textbackslash}citerogowitz98:
                  The goal of this research is semantic scene categorization for
                  CBIR. Through a set of psychophysical experiments the authors
                  identify two main axis of human categorization: human vs.
                  non-human and natural vs. man-made. From these main axis,
                  after more experiments, a set of 20 scene categories that seem
                  consistent to the subjects evolve. The subjects are asked to
                  find attributes and semantic descriptors for each of those
                  categories. In a next step these semantic features (e.g. "busy
                  scene") are translated to image-processing features (e.g.
                  "high spatial frequencies"). The image-processing features are
                  used to automatically classify unseen scenes into the semantic
                  categories. The results are mainly qualitatively, but quite
                  interesting. Unfortunately, the paper hasn't been published
                  officially yet. I just got a copy by the authors.},
}

