  booktitle =    {{IROS}},
  year =         1999,
  volume =       2,
  pages =        {966--971 vol.2},
  abstract =     {Development of multiple robot systems which solve complex and
                  dynamic problems in parallel and distributed manners is one of
                  the key issues in robotics research. The multiple robot
                  systems require robust methods to identify robots for
                  collaborative behaviors. This paper proposes a method using
                  omnidirectional vision sensors for the identification between
                  the robots. In addition to the several advantages of the
                  omnidirectional vision sensor as a vision of a mobile robot,
                  the omnidirectional vision sensor brings a significant benefit
                  for realizing collaborative behaviors in multiple robot
                  systems. After discussing on the algorithm, this paper shows
                  several simulation results and real experimental results in a
                  real environment},
}

