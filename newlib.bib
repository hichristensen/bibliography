  title =        {Readings in {Computer} {Vision}},
  publisher =    {Morgan Kaufman},
  year =         1987,
  editor =       {{M.Fischler} and Firschein, O.},
  note =         {Section: Visual Routines},
  annote =       {On importance of visual roiutines for determining spatial
                  realtions and shape properties of objects. Visual routines are
                  applied after obtaining 2 1/2 or primary sketch. The
                  application of visual routines is not botom up anymore and
                  representations are created to meet specific computational
                  goals. Visual routines can be viewed as elementary operations
                  or their combinations (either parallel or sequential comb.)
                  Examples of elementary visual routines are : 1. Shift of the
                  processing or focus (just apply particular operation to some
                  region). 2. Indexing (the region to which the operation will
                  be applied is indexed by some distinctive feature). 3. Bouded
                  activation (operation is applied over surface or boundary
                  stopping at discontinuities). 4. Boundary tracing (tracing a
                  single contour or number of contours) 5. Marking (operation of
                  marking a location - means location was remembered and the
                  processsing can return there when desirable.)},
}

