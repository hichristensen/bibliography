@Article{macenski_robot_2022,
  author =       {Macenski, Steven and Foote, Tully and Gerkey, Brian and
                  Lalancette, Chris and Woodall, William},
  title =        {Robot {Operating} {System} 2: {Design}, architecture, and uses
                  in the wild},
  journal =      {Science Robotics},
  year =         2022,
  volume =       7,
  number =       66,
  pages =        {eabm6074},
  note =         {\_eprint:
                  https://www.science.org/doi/pdf/10.1126/scirobotics.abm6074},
  url =          {https://www.science.org/doi/abs/10.1126/scirobotics.abm6074},
  doi =          {10.1126/scirobotics.abm6074},
  abstract =     {The next chapter of the robotics revolution is well underway
                  with the deployment of robots for a broad range of commercial
                  use cases. Even in a myriad of applications and environments,
                  there exists a common vocabulary of components that robots
                  share—the need for a modular, scalable, and reliable
                  architecture; sensing; planning; mobility; and autonomy. The
                  Robot Operating System (ROS) was an integral part of the last
                  chapter, demonstrably expediting robotics research with freely
                  available components and a modular framework. However, ROS 1
                  was not designed with many necessary production-grade features
                  and algorithms. ROS 2 and its related projects have been
                  redesigned from the ground up to meet the challenges set forth
                  by modern robotic systems in new and exploratory domains at
                  all scales. In this Review, we highlight the philosophical and
                  architectural changes of ROS 2 powering this new chapter in
                  the robotics revolution. We also show through case studies the
                  influence ROS 2 and its adoption has had on accelerating real
                  robot systems to reliable deployment in an assortment of
                  challenging environments. This Review describes ROS 2’s
                  design, features, and performance with four case studies on
                  land, air, sea, and even space.},
}

