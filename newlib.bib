@Article{poggio_generalisation_2004,
  author =       {Poggio, T. and Bizzi, E.},
  title =        {Generalisation in vision and motor control},
  journal =      {Nature},
  year =         2004,
  volume =       431,
  number =       7010,
  pages =        {768--773},
  month =        oct,
  annote =       {Learning is more than memory. it is not simply the building of
                  look-up tables of labelled images or a phone like dictionary
                  list of motor acts and the corresponding sequence of muscle
                  activities. central to intelligence is the ability to predict,
                  that it, to generalize to new situations, beyond the memory of
                  specific situations. The key to generalisation, in turn, isz
                  the architecture of the system, more than the rules of the
                  synaptic plasticity. We propose a specific architecture for
                  generalisation for both motor and visual imagery, and argue
                  for a canonical microcircuit underlying visual and motor
                  learning. The learning is based on linear
                  classifiers/estimator, with importance/uncertainty based
                  weighting!},
}

@Article{poggio_network_1990,
  author =       {Poggio, T. and Edelman, S.},
  title =        {A network that learns to recognize three-dimensional objects},
  journal =      {Nature},
  year =         1990,
  volume =       343,
  pages =        {263--266},
  month =        jan,
  abstract =     {The visual recognition of three-dimensional (3-D) objects on
                  the basis of their shape poses at least two difficult
                  problems. First, there is the problem of variable
                  illumination, which can be addressed by working with
                  relatively stable features such as intensity edges rather than
                  the raw intensity images. Second, there is the problem of the
                  initially unknown pose of the object relative to the viewer.
                  In one approach to this problem, a hypothesis is first made
                  about the viewpoint, then the appearance of a model object
                  from such a viewpoint is computed and compared with the actual
                  image. Such recognition schemes generally employ 3-D models of
                  objects, but the automatic learning of 3-D models is itself a
                  difficult problem. To address this problem in computational
                  vision, we have developed a scheme, based on the theory of
                  approximation of multivariate functions, that learns from a
                  small set of perspective views a function mapping any
                  viewpoint to a standard view. A network equivalent to this
                  scheme will thus 'recognize' the object on which it was
                  trained from any viewpoint.},
}

