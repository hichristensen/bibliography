@Article{oliva_modeling_2001,
  author =       {Oliva, A. and Torralba, A.},
  title =        {Modeling the {Shape} of the {Scene}: {A} {Holistic}
                  {Representation} of the {Spatial} {Envelope}},
  journal =      {International Journal of Computer Vision},
  year =         2001,
  volume =       42,
  number =       3,
  pages =        {145--175},
  month =        mar,
  annote =       {Summarizing
                  {\textbackslash}citeoliva01{\textbackslash}citeoliva02{\textbackslash}citetorralba01a{\textbackslash}citetorralba03a:
                  The work by Oliva and Torralba is based psychophysically on
                  the PhD work of Aude Oliva
                  {\textbackslash}citeoliva00{\textbackslash}citeschyns94. Even
                  when viewing scenes only for a very short time period, humans
                  are able to extract enough visual information to accurately
                  recognize its categorical properties. The authors thus use the
                  discrete Fourier transform (DFT) and the windowed DFT in order
                  to describe and to learn the spatial properties of certain
                  scene categories. In {\textbackslash}citeoliva01, they learn
                  the degrees of naturalness, of openness, of roughness, of
                  expansion and of ruggedness (spatial envelope properties) in
                  order to sort unseen images along these axes. In
                  {\textbackslash}citetorralba01a, the DFT and the windowed DFT
                  are used to determine the global depth of a scene without
                  absolute depth measurements. In general, the goal of the
                  authors' work is to generate scene-centered descriptions from
                  the spatial envelope properties
                  {\textbackslash}citeoliva02{\textbackslash}citetorralba03a.},
}

