@InProceedings{schroter_acquiring_2004,
  author =       {Schroter, D. and Beetz, M.},
  title =        {Acquiring {Models} of {Rectangular} {Objects} for {Robot}
                  {Maps}},
  booktitle =    {{ICRA}},
  year =         2004,
  abstract =     {State-of-the-art robot mapping approaches are capable of
                  acquiring impressively accurate 2D and 3D models of their
                  environments. To the best of our knowledge few of them can
                  acquire models of task-relevant objects. In this paper, we
                  introduce a novel method for acquiring models of taskrelevant
                  objects from stereo images. The proposed algorithm applies
                  methods from projective geometry and works for rectangular
                  objects, which are, in office- and museum-like environments,
                  the most commonly found subclass of geometric objects. The
                  method is shown to work accurately and for a wide range of
                  viewing angles and distances.},
}

@InProceedings{schroter_detection_2004,
