  title =        {Model refinement from planar parallax},
  booktitle =    {{BMVC}},
  year =         1999,
  abstract =     {This paper presents a system for refining the accuracy and
                  realism of coarse piecewise planar models from an uncalibrated
                  sequence of images. First, dense depth maps are estimated by
                  aligning a planar region of a scene in each image,
                  approximating camera calibration, and generating dense planar
                  parallax. These depth maps are then robustly fused to obtain
                  incrementally refined surface estimates. It is envisaged that
                  this system will extend the modelling capability of existing
                  systems [Cipolla99icmcs] which generate simple, piecewise
                  planar architectural models.},
}

