@InProceedings{wang_dslam_2005,
  author =       {Wang, Z. and Huang, S. and Dissanayake, G.},
  title =        {{DSLAM}: {Decoupled} {Localization} and {Mapping} for
                  {Autonomous} {Robots}},
  booktitle =    {International {Symposium} of {Robotics} {Research} ({ISRR}
                  05)},
  year =         2005,
  editor =       {Thrun, S. and Brooks, R. and Durrant-Whyte, H.},
  volume =       28,
  series =       {Springer {Tracts} in {Advanced} {Robotics} ({STAR})},
  pages =        {203--212},
  month =        oct,
  address =      {New York, NY},
  publisher =    {Springer Verlag},
  abstract =     {The main contribution of this paper is the reformulation of
                  the simultaneous localization and mapping (SLAM) problem for
                  mobile robots such that the mapping and localization can be
                  treated as two concurrent yet separated processes: DSLAM
                  (decoupled SLAM). It is shown that SLAM can be decoupled into
                  solving a nonlinear static estimation problem for mapping and
                  a lowdimensional dynamic estimation problem for localization.
                  The mapping problem can be solved using an Extended
                  Information Filter where the information matrix is shown to be
                  exactly sparse. A significant saving in the computational
                  effort can be achieved for large scale problems by exploiting
                  the special properties of sparse matrices. An important
                  feature of DSLAM is that the correlation among landmarks are
                  still kept and it is demonstrated that the uncertainty of the
                  map landmarks monotonically decrease. The algorithm is
                  illustrated through computer simulations and experiments.},
}

