@Article{duff_multifrontal_1983,
  author =       {Duff, I. S. and Reid, J. K.},
  title =        {The {Multifrontal} {Solution} of {Indefinite} {Sparse}
                  {Symmetric} {Linear} {Systems}},
  journal =      {ACM Trans. Math. Softw.},
