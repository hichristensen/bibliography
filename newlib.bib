@InProceedings{donald_information_1993,
  author =       {Donald, B. R.},
  title =        {Information {Invariants} for {Robotics}: {State},
                  {Communication}, and {Side}-{Effect}},
  booktitle =    {submitted to {IEEE} {ICRA}},
  year =         1993,
  annote =       {What is the trade-off bewteen the state (memory ) of the agent
                  and the amount of information communicated? - quite
                  theoretical analysis - using complexity theory + some nice
                  examples, i.e. why it is easier to search a maze then a graph?
                  or if a robot has a compas how much more powerfull it becomes,
                  or - the types of invariants discussed here are task related -
                  (not sensor related). Until know most widely used invariat in
                  kinodynamics was time, i.e most of the cost functions were
                  expressed in terms of time. The conclusions are that
                  communication between agents while searching a maze is
                  equivalent to a single agent with pebbles seraching the maze,
                  i.e. side-effecting the environment has the same complexity as
                  communication. Also if an automaton has an counter there exist
                  a log-space algorithm to search the maze vs. linear time
                  algorithms.},
}

