  author =       {Thrun, Sebastian and Bücken, Arno},
  title =        {Integrating {Grid}-{Based} and {Topological} {Maps} for
                  {Mobile} {Robot} {Navigation}},
  booktitle =    {Proc. of the {National} {Conference} on {Artificial}
