@InProceedings{olson_evaluating_2009,
  author =       {Olson, E. and Kaess, M.},
  title =        {Evaluating the {Performance} of {Robot} {Mapping} {Systems}},
  booktitle =    {Workshop on {Good} {Experimental} {Methodology} in {Robotics}},
  year =         2009,
  abstract =     {Localization and mapping are essential capabilities of
                  virtually all mobile robots. These topics have been the focus
                  of a great deal of research, but it is not always easy to tell
                  which methods are best. This paper discusses performance
                  evaluation for an important sub-problem of robot mapping, map
                  optimization. We explore aspects underlying the evaluation of
                  map optimization such as the quality of the result and
                  computational complexity. For each aspect we discuss
                  evaluation metrics and provide specific recommendations.},
}

@InProceedings{olson_fast_2006,
  author =       {Olson, E. and Leonard, J. and Teller, S.},
  title =        {Fast {Iterative} {Alignment} of {Pose} {Graphs} with {Poor}
                  {Initial} {Estimates}},
  booktitle =    {{ICRA}},
  year =         2006,
  pages =        {2262--2269},
  month =        may,
  note =         {Place: Orlando, FL},
  abstract =     {A robot exploring an environment can estimate its own motion
                  and the relative positions of features in the environment.
                  Simultaneous Localization and Mapping (SLAM) algorithms
                  attempt to fuse these estimates to produce a map and a robot
                  trajectory. The constraints are generally non-linear, thus
                  SLAM can be viewed as a non-linear optimization problem. The
                  optimization can be difficult, due to poor initial estimates
                  arising from odometry data, and due to the size of the state
                  space. We present a fast non-linear optimization algorithm
                  that rapidly recovers the robot trajectory, even when given a
                  poor initial estimate. Our approach uses a variant of
                  Stochastic Gradient Descent on an alternative state-space
                  representation that has good stability and computational
                  properties.We compare our algorithm to several others, using
                  both real and synthetic data sets.},
}

